# Copy this file to .env and fill in the keys for whichever provider(s)
# you use. .env is already in .gitignore -- never commit your real keys.
#
#   cp .env.example .env
#   # then edit .env and paste your real key(s) in
#
# Nothing here is required to run the pipeline itself (Phases 1-4) or
# the test suite -- these are only read by the LLM provider classes in
# forge/llm/ (Phase 5/6), and only the ones you actually use.

# --- Groq (free tier, no credit card) -------------------------------
# 1. Go to https://console.groq.com/keys
# 2. Sign in (email or Google account)
# 3. Click "Create API Key", copy it, paste below
GROQ_API_KEY=

# --- Anthropic (paid, no free tier) ---------------------------------
# 1. Go to https://console.anthropic.com/settings/keys
# 2. Create a key, copy it, paste below
ANTHROPIC_API_KEY=

# --- Ollama (local, no key needed) ----------------------------------
# No key required. Just make sure Ollama is running locally
# (https://ollama.com) and you've pulled a model:
#   ollama pull llama3.1:8b
# If Ollama is running on a non-default host/port, set this instead:
# OLLAMA_BASE_URL=http://localhost:11434
